# Turnos Odontología — environment template (copy to .env and fill in).
# NEVER commit a real .env. All secrets below are CHANGEME placeholders.
# All example values are fictitious.

# Postgres (async driver). Format only — credentials are placeholders.
DATABASE_URL=postgresql+asyncpg://CHANGEME:CHANGEME@localhost:5432/turnos
# JWT signing secret — REQUIRED, no default anywhere in code.
JWT_SECRET=CHANGEME-replace-with-a-long-random-secret
# Browser origins allowed to call the API (comma-separated; never use * with credentials).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WhatsApp BSP (stub until C-10) — leave empty until configured.
WA_BSP_TOKEN=
WA_PHONE_ID=
# Mercado Pago (stub until C-09) — leave empty until configured.
MP_ACCESS_TOKEN=
# Public base URL used to build patient-facing links.
SLOT_PUBLIC_BASE_URL=http://localhost:8000
# Reminder / cancellation policy defaults (hours, numeric).
REMINDER_T48H_HS=48
REMINDER_T24H_HS=24
DEFAULT_CANCEL_ANTICIP_HS=24
# C-10: plazo (horas) para vencer órdenes MP sin acreditar (worker, default 24).
COBROS_PLAZO_HS=24
# C-11: WhatsApp webhook signature secret + SMTP fallback (leave empty in dev).
WHATSAPP_WEBHOOK_SECRET=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@turnos.invalid
# C-11: confirmation threshold (hours), absent recall (days) and retry policy.
CONFIRMATION_THRESHOLD_HS=24
RECALL_AUSENTE_DIAS=7
NOTIF_MAX_INTENTOS=3
NOTIF_BACKOFF_BASE_S=0.5

# C-13: private storage for clinical attachments (memory|local).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=var/storage
STORAGE_SIGNED_URL_TTL_SEG=300
STORAGE_SIGNING_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
ADJUNTO_MAX_BYTES=10485760
ADJUNTO_MIME_PERMITIDOS=image/jpeg,image/png,image/webp,application/pdf

# C-14: dias de validez por defecto de un presupuesto (entero positivo).
PRESUPUESTO_VALIDEZ_DIAS=30
