# Turnos Odontología — environment template (copy to .env and fill in).
# NEVER commit a real .env. All secrets below are CHANGEME placeholders.
# All example values are fictitious.

# Postgres (async driver). Format only — credentials are placeholders.
DATABASE_URL=postgresql+asyncpg://CHANGEME:CHANGEME@localhost:5432/turnos
# JWT signing secret — REQUIRED, no default anywhere in code.
JWT_SECRET=CHANGEME-replace-with-a-long-random-secret
# WhatsApp BSP (stub until C-10) — leave empty until configured.
WA_BSP_TOKEN=
WA_PHONE_ID=
# Mercado Pago (stub until C-09) — leave empty until configured.
MP_ACCESS_TOKEN=
# Public base URL used to build patient-facing links.
SLOT_PUBLIC_BASE_URL=http://localhost:8000
# Reminder / cancellation policy defaults (hours, numeric).
REMINDER_T48H_HS=48
REMINDER_T24H_HS=24
DEFAULT_CANCEL_ANTICIP_HS=24
